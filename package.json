{
  "name": "reforged-chinese-dungeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/engine tests/e2e scripts/*.mjs *.ts",
    "test": "node scripts/verify-reference.mjs && vitest run",
    "test:e2e": "node scripts/verify-reference.mjs && node scripts/run-browser-tests.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "audit:check": "node scripts/audit-source.mjs --check",
    "verify:reference": "node scripts/verify-reference.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "gsap": "3.12.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
