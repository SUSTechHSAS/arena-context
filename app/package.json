{
  "name": "reforged-chinese-dungeon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:reference": "node scripts/verify-reference.mjs",
    "test": "vitest run",
    "test:mutation": "node scripts/check-mutation.mjs",
    "build": "npm run typecheck && vite build",
    "check": "npm run verify:reference && npm run typecheck && npm test && npm run test:mutation && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.19.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
